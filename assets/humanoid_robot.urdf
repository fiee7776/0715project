<?xml version="1.0" ?>
<robot name="humanoid_robot">
  <!-- 定义机器人的本体部分 -->
  
  <!-- 基座 (躯干) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.3 0.2 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.5 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.2 0.5"/>
      </geometry>
    </collision>
  </link>
  
  <!-- 左肩关节 -->
  <joint name="left_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="left_shoulder_link"/>
    <origin xyz="-0.15 0.15 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="500" velocity="5.0"/>
  </joint>
  
  <link name="left_shoulder_link">
    <inertial>
      <origin xyz="0 0.1 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.05"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
      <material name="red">
        <color rgba="0.9 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.05"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
    </collision>
  </link>
  
  <!-- 左肘关节 -->
  <joint name="left_elbow" type="revolute">
    <parent link="left_shoulder_link"/>
    <child link="left_forearm_link"/>
    <origin xyz="0 0.2 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="3.14159" effort="500" velocity="5.0"/>
  </joint>
  
  <link name="left_forearm_link">
    <inertial>
      <origin xyz="0 0.1 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.04"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.04"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
    </collision>
  </link>
  
  <!-- 右肩关节 -->
  <joint name="right_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="right_shoulder_link"/>
    <origin xyz="0.15 0.15 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="500" velocity="5.0"/>
  </joint>
  
  <link name="right_shoulder_link">
    <inertial>
      <origin xyz="0 0.1 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.05"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
      <material name="red">
        <color rgba="0.9 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.05"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
    </collision>
  </link>
  
  <!-- 右肘关节 -->
  <joint name="right_elbow" type="revolute">
    <parent link="right_shoulder_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0 0.2 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="3.14159" effort="500" velocity="5.0"/>
  </joint>
  
  <link name="right_forearm_link">
    <inertial>
      <origin xyz="0 0.1 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.04"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.04"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="0 1.5707 0"/>
    </collision>
  </link>

</robot>
