<?xml version="1.0" ?>
<robot name="humanoid_robot_mediapipe_v2">
  <!-- 新的人型外观：球头、梯形躯干、圆柱四肢、球形手脚 -->

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="torso_bend" type="revolute">
    <parent link="base_link"/>
    <child link="torso_bend_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.7" upper="0.7" effort="300" velocity="2.0"/>
  </joint>

  <link name="torso_bend_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="torso_twist" type="revolute">
    <parent link="torso_bend_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="300" velocity="2.0"/>
  </joint>

  <link name="torso_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="trapezoid_torso.obj"/>
      </geometry>
      <material name="torso_red">
        <color rgba="0.78 0.28 0.28 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="trapezoid_torso.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="neck_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="neck_link">
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.25"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="skin_tone">
        <color rgba="0.93 0.79 0.67 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.12" radius="0.03"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <material name="skin_head">
        <color rgba="0.93 0.79 0.67 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_shoulder" type="revolute">
    <parent link="torso_link"/>
    <child link="left_shoulder_link"/>
    <origin xyz="-0.16 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="4.0"/>
  </joint>

  <link name="left_shoulder_link">
    <inertial>
      <origin xyz="-0.14 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.28" radius="0.035"/>
      </geometry>
      <origin xyz="-0.14 0 0" rpy="0 1.5707 0"/>
      <material name="arm_red">
        <color rgba="0.9 0.25 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.28" radius="0.035"/>
      </geometry>
      <origin xyz="-0.14 0 0" rpy="0 1.5707 0"/>
    </collision>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="left_shoulder_link"/>
    <child link="left_forearm_link"/>
    <origin xyz="-0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14159" effort="150" velocity="4.0"/>
  </joint>

  <link name="left_forearm_link">
    <inertial>
      <origin xyz="-0.125 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.032"/>
      </geometry>
      <origin xyz="-0.125 0 0" rpy="0 1.5707 0"/>
      <material name="arm_orange">
        <color rgba="0.98 0.57 0.12 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.032"/>
      </geometry>
      <origin xyz="-0.125 0 0" rpy="0 1.5707 0"/>
    </collision>
  </link>

  <joint name="left_hand_joint" type="fixed">
    <parent link="left_forearm_link"/>
    <child link="left_hand_link"/>
    <origin xyz="-0.25 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_hand_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="hand_sphere">
        <color rgba="0.95 0.82 0.72 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_shoulder" type="revolute">
    <parent link="torso_link"/>
    <child link="right_shoulder_link"/>
    <origin xyz="0.16 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="4.0"/>
  </joint>

  <link name="right_shoulder_link">
    <inertial>
      <origin xyz="0.14 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.28" radius="0.035"/>
      </geometry>
      <origin xyz="0.14 0 0" rpy="0 1.5707 0"/>
      <material name="arm_red">
        <color rgba="0.9 0.25 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.28" radius="0.035"/>
      </geometry>
      <origin xyz="0.14 0 0" rpy="0 1.5707 0"/>
    </collision>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="right_shoulder_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14159" effort="150" velocity="4.0"/>
  </joint>

  <link name="right_forearm_link">
    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.032"/>
      </geometry>
      <origin xyz="0.125 0 0" rpy="0 1.5707 0"/>
      <material name="arm_orange">
        <color rgba="0.98 0.57 0.12 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.032"/>
      </geometry>
      <origin xyz="0.125 0 0" rpy="0 1.5707 0"/>
    </collision>
  </link>

  <joint name="right_hand_joint" type="fixed">
    <parent link="right_forearm_link"/>
    <child link="right_hand_link"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_hand_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="hand_sphere">
        <color rgba="0.95 0.82 0.72 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="torso_link"/>
    <child link="left_thigh_link"/>
    <origin xyz="-0.09 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="3.0"/>
  </joint>

  <link name="left_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.21"/>
      <mass value="0.9"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.42" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 -0.21" rpy="0 0 0"/>
      <material name="leg_blue">
        <color rgba="0.2 0.5 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.42" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>
    <origin xyz="0 0 -0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14159" effort="200" velocity="3.0"/>
  </joint>

  <link name="left_shin_link">
    <inertial>
      <origin xyz="0 0 -0.20"/>
      <mass value="0.75"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.40" radius="0.035"/>
      </geometry>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <material name="leg_cyan">
        <color rgba="0.26 0.62 0.98 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.40" radius="0.035"/>
      </geometry>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="left_foot_joint" type="fixed">
    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
  </joint>

  <link name="left_foot_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
      <material name="foot_brown">
        <color rgba="0.45 0.30 0.18 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="torso_link"/>
    <child link="right_thigh_link"/>
    <origin xyz="0.09 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="200" velocity="3.0"/>
  </joint>

  <link name="right_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.21"/>
      <mass value="0.9"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.42" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 -0.21" rpy="0 0 0"/>
      <material name="leg_blue">
        <color rgba="0.2 0.5 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.42" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>
    <origin xyz="0 0 -0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="3.14159" effort="200" velocity="3.0"/>
  </joint>

  <link name="right_shin_link">
    <inertial>
      <origin xyz="0 0 -0.20"/>
      <mass value="0.75"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.40" radius="0.035"/>
      </geometry>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <material name="leg_cyan">
        <color rgba="0.26 0.62 0.98 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.40" radius="0.035"/>
      </geometry>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="right_foot_joint" type="fixed">
    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
  </joint>

  <link name="right_foot_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
      <material name="foot_brown">
        <color rgba="0.45 0.30 0.18 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
    </collision>
