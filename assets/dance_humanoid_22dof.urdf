<?xml version="1.0"?>
<robot name="dance_humanoid_22dof">
  <material name="mat_torso"><color rgba="0.18 0.32 0.72 1"/></material>
  <material name="mat_core"><color rgba="0.12 0.12 0.14 1"/></material>
  <material name="mat_left_arm"><color rgba="0.88 0.26 0.22 1"/></material>
  <material name="mat_right_arm"><color rgba="0.94 0.58 0.16 1"/></material>
  <material name="mat_left_leg"><color rgba="0.18 0.56 0.88 1"/></material>
  <material name="mat_right_leg"><color rgba="0.16 0.70 0.54 1"/></material>
  <material name="mat_skin"><color rgba="0.93 0.78 0.65 1"/></material>
  <material name="mat_joint"><color rgba="0.05 0.05 0.06 1"/></material>

  <link name="base_link">
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="root_yaw" type="revolute">
    <parent link="base_link"/><child link="root_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="500" velocity="5"/>
  </joint>
  <link name="root_yaw_link"><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>

  <joint name="torso_roll" type="revolute">
    <parent link="root_yaw_link"/><child link="torso_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="500" velocity="5"/>
  </joint>
  <link name="torso_roll_link"><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>

  <joint name="torso_pitch" type="revolute">
    <parent link="torso_roll_link"/><child link="torso_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="500" velocity="5"/>
  </joint>
  <link name="torso_link">
    <inertial><origin xyz="0 0 0.08"/><mass value="6"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.08"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><box size="0.38 0.18 0.52"/></geometry><material name="mat_torso"/></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="0.38 0.18 0.52"/></geometry></collision>
  </link>

  <joint name="neck_fixed" type="fixed"><parent link="torso_link"/><child link="head_link"/><origin xyz="0 0 0.44" rpy="0 0 0"/></joint>
  <link name="head_link">
    <inertial><mass value="1.1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><sphere radius="0.115"/></geometry><material name="mat_skin"/></visual>
    <collision><geometry><sphere radius="0.115"/></geometry></collision>
  </link>

  <!-- Left arm: yaw + roll + pitch shoulder, elbow, wrist yaw/pitch. -->
  <joint name="left_shoulder_yaw" type="revolute"><parent link="torso_link"/><child link="left_shoulder_yaw_link"/><origin xyz="0 0.18 0.28" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.4" upper="2.4" effort="220" velocity="6"/></joint>
  <link name="left_shoulder_yaw_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_joint"/></visual></link>
  <joint name="left_shoulder_roll" type="revolute"><parent link="left_shoulder_yaw_link"/><child link="left_shoulder_roll_link"/><axis xyz="1 0 0"/><limit lower="-2.8" upper="2.8" effort="220" velocity="6"/></joint>
  <link name="left_shoulder_roll_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="left_shoulder_pitch" type="revolute"><parent link="left_shoulder_roll_link"/><child link="left_upper_arm"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" effort="220" velocity="6"/></joint>
  <link name="left_upper_arm"><inertial><origin xyz="0 0.16 0"/><mass value="0.9"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0.16 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.32" radius="0.04"/></geometry><material name="mat_left_arm"/></visual><collision><origin xyz="0 0.16 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.32" radius="0.04"/></geometry></collision></link>
  <joint name="left_elbow" type="revolute"><parent link="left_upper_arm"/><child link="left_forearm"/><origin xyz="0 0.32 0"/><axis xyz="1 0 0"/><limit lower="0" upper="2.75" effort="180" velocity="6"/></joint>
  <link name="left_forearm"><inertial><origin xyz="0 0.145 0"/><mass value="0.7"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial><visual><origin xyz="0 0.145 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.29" radius="0.034"/></geometry><material name="mat_left_arm"/></visual><collision><origin xyz="0 0.145 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.29" radius="0.034"/></geometry></collision></link>
  <joint name="left_wrist_yaw" type="revolute"><parent link="left_forearm"/><child link="left_wrist_yaw_link"/><origin xyz="0 0.29 0"/><axis xyz="0 0 1"/><limit lower="-1.4" upper="1.4" effort="80" velocity="7"/></joint>
  <link name="left_wrist_yaw_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="left_wrist_pitch" type="revolute"><parent link="left_wrist_yaw_link"/><child link="left_hand"/><axis xyz="1 0 0"/><limit lower="-1.2" upper="1.2" effort="80" velocity="7"/></joint>
  <link name="left_hand"><inertial><mass value="0.18"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_skin"/></visual><collision><geometry><sphere radius="0.055"/></geometry></collision></link>

  <!-- Right arm. -->
  <joint name="right_shoulder_yaw" type="revolute"><parent link="torso_link"/><child link="right_shoulder_yaw_link"/><origin xyz="0 -0.18 0.28" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.4" upper="2.4" effort="220" velocity="6"/></joint>
  <link name="right_shoulder_yaw_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_joint"/></visual></link>
  <joint name="right_shoulder_roll" type="revolute"><parent link="right_shoulder_yaw_link"/><child link="right_shoulder_roll_link"/><axis xyz="1 0 0"/><limit lower="-2.8" upper="2.8" effort="220" velocity="6"/></joint>
  <link name="right_shoulder_roll_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="right_shoulder_pitch" type="revolute"><parent link="right_shoulder_roll_link"/><child link="right_upper_arm"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" effort="220" velocity="6"/></joint>
  <link name="right_upper_arm"><inertial><origin xyz="0 -0.16 0"/><mass value="0.9"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 -0.16 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.32" radius="0.04"/></geometry><material name="mat_right_arm"/></visual><collision><origin xyz="0 -0.16 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.32" radius="0.04"/></geometry></collision></link>
  <joint name="right_elbow" type="revolute"><parent link="right_upper_arm"/><child link="right_forearm"/><origin xyz="0 -0.32 0"/><axis xyz="-1 0 0"/><limit lower="0" upper="2.75" effort="180" velocity="6"/></joint>
  <link name="right_forearm"><inertial><origin xyz="0 -0.145 0"/><mass value="0.7"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial><visual><origin xyz="0 -0.145 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.29" radius="0.034"/></geometry><material name="mat_right_arm"/></visual><collision><origin xyz="0 -0.145 0" rpy="1.5708 0 0"/><geometry><cylinder length="0.29" radius="0.034"/></geometry></collision></link>
  <joint name="right_wrist_yaw" type="revolute"><parent link="right_forearm"/><child link="right_wrist_yaw_link"/><origin xyz="0 -0.29 0"/><axis xyz="0 0 1"/><limit lower="-1.4" upper="1.4" effort="80" velocity="7"/></joint>
  <link name="right_wrist_yaw_link"><inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="right_wrist_pitch" type="revolute"><parent link="right_wrist_yaw_link"/><child link="right_hand"/><axis xyz="-1 0 0"/><limit lower="-1.2" upper="1.2" effort="80" velocity="7"/></joint>
  <link name="right_hand"><inertial><mass value="0.18"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_skin"/></visual><collision><geometry><sphere radius="0.055"/></geometry></collision></link>

  <!-- Left leg: yaw + roll + pitch hip, knee, ankle pitch/roll. -->
  <joint name="left_hip_yaw" type="revolute"><parent link="torso_link"/><child link="left_hip_yaw_link"/><origin xyz="0 0.105 -0.22"/><axis xyz="0 0 1"/><limit lower="-1.3" upper="1.3" effort="280" velocity="5"/></joint>
  <link name="left_hip_yaw_link"><inertial><mass value="0.06"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_joint"/></visual></link>
  <joint name="left_hip_roll" type="revolute"><parent link="left_hip_yaw_link"/><child link="left_hip_roll_link"/><axis xyz="1 0 0"/><limit lower="-1.4" upper="1.4" effort="280" velocity="5"/></joint>
  <link name="left_hip_roll_link"><inertial><mass value="0.06"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="left_hip_pitch" type="revolute"><parent link="left_hip_roll_link"/><child link="left_thigh"/><axis xyz="0 1 0"/><limit lower="-1.8" upper="1.8" effort="280" velocity="5"/></joint>
  <link name="left_thigh"><inertial><origin xyz="0 0 -0.205"/><mass value="1.25"/><inertia ixx="0.015" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.006"/></inertial><visual><origin xyz="0 0 -0.205"/><geometry><cylinder length="0.41" radius="0.048"/></geometry><material name="mat_left_leg"/></visual><collision><origin xyz="0 0 -0.205"/><geometry><cylinder length="0.41" radius="0.048"/></geometry></collision></link>
  <joint name="left_knee" type="revolute"><parent link="left_thigh"/><child link="left_shin"/><origin xyz="0 0 -0.41"/><axis xyz="0 1 0"/><limit lower="0" upper="2.65" effort="260" velocity="5"/></joint>
  <link name="left_shin"><inertial><origin xyz="0 0 -0.19"/><mass value="0.95"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/></inertial><visual><origin xyz="0 0 -0.19"/><geometry><cylinder length="0.38" radius="0.04"/></geometry><material name="mat_left_leg"/></visual><collision><origin xyz="0 0 -0.19"/><geometry><cylinder length="0.38" radius="0.04"/></geometry></collision></link>
  <joint name="left_ankle_pitch" type="revolute"><parent link="left_shin"/><child link="left_ankle_pitch_link"/><origin xyz="0 0 -0.38"/><axis xyz="0 1 0"/><limit lower="-0.9" upper="0.9" effort="120" velocity="5"/></joint>
  <link name="left_ankle_pitch_link"><inertial><mass value="0.04"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="left_ankle_roll" type="revolute"><parent link="left_ankle_pitch_link"/><child link="left_foot"/><axis xyz="1 0 0"/><limit lower="-0.7" upper="0.7" effort="120" velocity="5"/></joint>
  <link name="left_foot"><inertial><origin xyz="0.08 0 -0.02"/><mass value="0.35"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial><visual><origin xyz="0.08 0 -0.02"/><geometry><box size="0.22 0.10 0.055"/></geometry><material name="mat_core"/></visual><collision><origin xyz="0.08 0 -0.02"/><geometry><box size="0.22 0.10 0.055"/></geometry></collision></link>

  <!-- Right leg. -->
  <joint name="right_hip_yaw" type="revolute"><parent link="torso_link"/><child link="right_hip_yaw_link"/><origin xyz="0 -0.105 -0.22"/><axis xyz="0 0 1"/><limit lower="-1.3" upper="1.3" effort="280" velocity="5"/></joint>
  <link name="right_hip_yaw_link"><inertial><mass value="0.06"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial><visual><geometry><sphere radius="0.055"/></geometry><material name="mat_joint"/></visual></link>
  <joint name="right_hip_roll" type="revolute"><parent link="right_hip_yaw_link"/><child link="right_hip_roll_link"/><axis xyz="1 0 0"/><limit lower="-1.4" upper="1.4" effort="280" velocity="5"/></joint>
  <link name="right_hip_roll_link"><inertial><mass value="0.06"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="right_hip_pitch" type="revolute"><parent link="right_hip_roll_link"/><child link="right_thigh"/><axis xyz="0 1 0"/><limit lower="-1.8" upper="1.8" effort="280" velocity="5"/></joint>
  <link name="right_thigh"><inertial><origin xyz="0 0 -0.205"/><mass value="1.25"/><inertia ixx="0.015" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.006"/></inertial><visual><origin xyz="0 0 -0.205"/><geometry><cylinder length="0.41" radius="0.048"/></geometry><material name="mat_right_leg"/></visual><collision><origin xyz="0 0 -0.205"/><geometry><cylinder length="0.41" radius="0.048"/></geometry></collision></link>
  <joint name="right_knee" type="revolute"><parent link="right_thigh"/><child link="right_shin"/><origin xyz="0 0 -0.41"/><axis xyz="0 1 0"/><limit lower="0" upper="2.65" effort="260" velocity="5"/></joint>
  <link name="right_shin"><inertial><origin xyz="0 0 -0.19"/><mass value="0.95"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/></inertial><visual><origin xyz="0 0 -0.19"/><geometry><cylinder length="0.38" radius="0.04"/></geometry><material name="mat_right_leg"/></visual><collision><origin xyz="0 0 -0.19"/><geometry><cylinder length="0.38" radius="0.04"/></geometry></collision></link>
  <joint name="right_ankle_pitch" type="revolute"><parent link="right_shin"/><child link="right_ankle_pitch_link"/><origin xyz="0 0 -0.38"/><axis xyz="0 1 0"/><limit lower="-0.9" upper="0.9" effort="120" velocity="5"/></joint>
  <link name="right_ankle_pitch_link"><inertial><mass value="0.04"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="right_ankle_roll" type="revolute"><parent link="right_ankle_pitch_link"/><child link="right_foot"/><axis xyz="1 0 0"/><limit lower="-0.7" upper="0.7" effort="120" velocity="5"/></joint>
  <link name="right_foot"><inertial><origin xyz="0.08 0 -0.02"/><mass value="0.35"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial><visual><origin xyz="0.08 0 -0.02"/><geometry><box size="0.22 0.10 0.055"/></geometry><material name="mat_core"/></visual><collision><origin xyz="0.08 0 -0.02"/><geometry><box size="0.22 0.10 0.055"/></geometry></collision></link>
</robot>
